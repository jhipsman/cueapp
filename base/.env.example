# Supabase project (Project Settings > API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key for the assistant (server only).
ANTHROPIC_API_KEY=

# Who may sign in, comma-separated. Anyone else is turned away at the login page.
BASE_ALLOWED_EMAILS=
